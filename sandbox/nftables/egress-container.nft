#!/usr/sbin/nft -f
# =============================================================================
# agent-ide - container-side egress policy (Tier 1b: default-deny, LAN allowed)
# =============================================================================
#
# This is the *inside* half of the sandbox: rules that live in the container's
# own network namespace, applied at container start by
#
#     /usr/local/bin/agent-ide-sandbox        (sandbox/scripts/agent-egress-container.sh)
#
# Why it exists: it is the only mechanism that filters the **default rootless
# network**. With per-container pasta the container's traffic is emitted by the
# pasta process as ordinary host sockets, so no rule outside the container ever
# sees it (see sandbox/README.md, §2 and Tier 1b).
#
# Behaviour: traffic the container sends may only go to
#   * its own subnets (`own4` / `own6`, filled in from its routing table by
#     agent-ide-sandbox: container <-> container, the bridge gateway, DNS,
#     and with pasta the host's LAN subnet),
#   * the site allowlist in `allowed4` / `allowed6` (your LAN: NFS, model
#     gateway, internal resolver).
# Everything else - public IP space - is logged, counted and dropped. Cloud
# metadata endpoints are dropped although they sit inside link-local.
#
# Chain notes
#   * It hooks `output`, i.e. traffic originated by this container. Replies to
#     connections that arrive through published ports are `established` and are
#     accepted first.
#   * It does not affect the host, other containers, or the rootless netns.
#   * Applying it needs CAP_NET_ADMIN (`--cap-add=NET_ADMIN`). A container that
#     has that can also remove these rules - this is accident prevention, not a
#     boundary against a determined insider (see sandbox/README.md "Scope").
#   * Multicast (mDNS, LLMNR) is not in the allowlist and is therefore dropped.
#
# Editing the allowlist: see the SITE POLICY block below, or set
# AGENT_IDE_SANDBOX_ALLOW="10.20.0.0/16 192.0.2.7/32" on the container, which
# adds ranges on top of the file without editing the image.
# =============================================================================

table inet agent_egress_out {
	# ---------------------------------------------------------- dynamic sets
	# Filled in by agent-ide-sandbox from the container's own routing table
	# (its directly connected networks). Leave empty in the file.
	set own4 {
		type ipv4_addr
		flags interval
	}
	set own6 {
		type ipv6_addr
		flags interval
	}

	# ----------------------------------------------------------- SITE POLICY
	# Everything the container may reach. RFC1918 + link-local by default;
	# narrow it to your NFS host and gateway if you can.
	set allowed4 {
		type ipv4_addr
		flags interval
		elements = {
			10.0.0.0/8,		# RFC1918
			172.16.0.0/12,		# RFC1918
			192.168.0.0/16,		# RFC1918
			169.254.0.0/16,		# link-local: pasta's DNS forwarder is 169.254.1.1
			# 100.64.0.0/10,	# CGNAT - add only if the NFS/gateway lives there
		}
	}
	set allowed6 {
		type ipv6_addr
		flags interval
		elements = {
			fc00::/7,		# unique local addresses
			fe80::/10,		# link-local (pasta's DNS, neighbour discovery)
		}
	}

	# Never reachable, even though the allowlist above would permit them:
	# instance metadata services are credential theft, not "local traffic".
	set never4 {
		type ipv4_addr
		flags interval
		elements = {
			169.254.169.254,	# AWS / GCP / Azure / OpenStack metadata
			169.254.170.2,		# ECS task metadata
			100.100.100.200,	# Alibaba Cloud metadata
			168.63.129.16,		# Azure platform
			192.0.0.192,		# Oracle Cloud metadata
		}
	}
	set never6 {
		type ipv6_addr
		flags interval
		elements = {
			fd00:ec2::254,		# AWS IMDSv6
		}
	}

	# Named so the status output and any log collector can read it:
	# `nft list counter inet agent_egress_out agent_egress_out_drops`.
	counter agent_egress_out_drops {
	}

	# ---------------------------------------------------------------- chain
	chain output {
		type filter hook output priority 0; policy accept;

		# Replies to connections that came in through a published port.
		ct state established,related accept

		# The container's own loopback.
		ip daddr 127.0.0.0/8 accept
		ip6 daddr ::1 accept

		# Metadata endpoints first: the allowlist must not resurrect them.
		ip daddr @never4 counter drop comment "cloud metadata"
		ip6 daddr @never6 counter drop comment "cloud metadata"

		# Its own networks (container neighbours, gateway, DNS) ...
		ip daddr @own4 accept
		ip6 daddr @own6 accept

		# ... and the site allowlist.
		ip daddr @allowed4 accept
		ip6 daddr @allowed6 accept

		# Everything else: public IP space.
		log prefix "agent-egress-drop: " level warn limit rate 6/minute
		counter name "agent_egress_out_drops" drop comment "default deny: destination not in allowlist"
	}
}
