# Example settings file for the agent-ide bundle images.
#
# The entrypoint sources /etc/agent-ide/openai.env (if it exists) before it
# renders each agent's configuration, so a file like this one can replace a
# pile of `-e` flags. Mount your own copy over it:
#
#   podman run -d --name devbox \
#     -v ./openai.env:/etc/agent-ide/openai.env:ro \
#     agent-ide-opencode:rocky9 sleep infinity
#
# Every variable listed here is exported, so tools that read them directly
# (for example goose's GOOSE_PROVIDER or pi's PI_OFFLINE) see them too.
# Start from agents/README.md's environment contract for the full list.

OPENAI_BASE_URL=http://gateway.internal:8080/v1
OPENAI_API_KEY=sk-change-me
OPENAI_MODEL=qwen3-coder
# OPENAI_MODEL_NAME=Qwen3 Coder
# OPENAI_API_TYPE=chat-completions
# OPENAI_BASE_PATH=v1/chat/completions
# PI_OFFLINE=
# AGENT_IDE_STRICT=1
